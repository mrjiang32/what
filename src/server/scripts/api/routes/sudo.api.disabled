import { generateSalt } from "../../utils/passwd.js";

let lock;

export async function sudoRequired(token) {
  if (!lock) {
    throw new Error("Lock is empty.");
  }
  if (token === lock) {
    return true;
  }
  throw new Error("Token is Invalid.");
}

