{
  "scripts": {
    "server:dev": "cd ./src/server && npm run dev",
    "server:start": "cd ./src/server && npm run start",
    "server:stop": "cd ./src/server && npm run stop",
    "server:install": "cd ./src/server && npm install",
    "clean": "rimraf node_modules package-lock.json",
    "clean:all": "rimraf node_modules package-lock.json src/server/node_modules src/server/package-lock.json",
    "reinstall": "npm run clean:all && npm run server:install"
  },
  "dependencies": {
    "log4js": "^6.9.1"
  }
}
